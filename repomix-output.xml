<file path="tests/Feature/HomepageTest.php">
<?php

use Illuminate\Support\Facades\Route;

it('renders the approved homepage journey with safe empty states', function () {
    $response = $this->get(route('home'));

    $response
        ->assertOk()
        ->assertSee('Property solutions built around your next move.')
        ->assertSee('One company. More ways to move forward with property.')
        ->assertSee('Property opportunities are being prepared.')
        ->assertSee('Shortlet listings will appear when verified.')
        ->assertSee('See the property before making your next decision.')
        ->assertSee('What would you like to know?')
        ->assertDontSee('testimonial', false)
        ->assertDontSee('href="#"', false)
        ->assertDontSee('[Verified', false)
        ->assertDontSee('hello@example.com', false);

    expect(substr_count($response->getContent(), '<h1'))->toBe(1);
    expect(Route::has('home'))->toBeTrue();
    expect(Route::has('inspections.create'))->toBeFalse();
    expect(Route::has('inspections.store'))->toBeFalse();
});

it('hides unavailable contact channels', function () {
    config()->set('selotemna', [
        'phone' => null,
        'whatsapp' => null,
        'email' => null,
        'address' => null,
        'business_hours' => null,
    ]);

    $this->get(route('home'))
        ->assertOk()
        ->assertDontSee('tel:', false)
        ->assertDontSee('wa.me', false)
        ->assertDontSee('mailto:', false);
});

it('renders verified contact channels with safe links', function () {
    config()->set('selotemna', [
        'phone' => '+234 800 000 0000',
        'whatsapp' => '+2348000000000',
        'email' => 'contact@selotemna.test',
        'address' => 'Verified office address',
        'business_hours' => 'Verified business hours',
    ]);

    $this->get(route('home'))
        ->assertOk()
        ->assertSee('tel:+2348000000000', false)
        ->assertSee('https://wa.me/2348000000000', false)
        ->assertSee('mailto:contact@selotemna.test', false)
        ->assertSee('Verified office address')
        ->assertSee('Verified business hours');
});
</file>

